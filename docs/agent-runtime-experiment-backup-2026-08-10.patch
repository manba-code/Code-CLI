+     * Planner 偶尔会在 JSON 代码块前后补一句说明。计划入口允许提取其中唯一的 JSON 对象，
+     * Reviewer 的审批协议仍保持严格 JSON-only，避免把审查异常误判为通过。
+     */
+    private String extractPlanJson(String planContent) {
+        if (planContent == null) {
+            return "";
+        }
+        String trimmed = planContent.trim();
+        Matcher fenced = JSON_CODE_BLOCK.matcher(trimmed);
+        if (fenced.find()) {
+            return fenced.group(1).trim();
+        }
+
+        int start = trimmed.indexOf('{');
+        if (start < 0) {
+            return trimmed;
+        }
+
+        int depth = 0;
+        boolean inString = false;
+        boolean escaped = false;
+        for (int i = start; i < trimmed.length(); i++) {
+            char current = trimmed.charAt(i);
+            if (inString) {
+                if (escaped) {
+                    escaped = false;
+                } else if (current == '\\') {
+                    escaped = true;
+                } else if (current == '"') {
+                    inString = false;
+                }
+                continue;
+            }
+            if (current == '"') {
+                inString = true;
+            } else if (current == '{') {
+                depth++;
+            } else if (current == '}' && --depth == 0) {
+                return trimmed.substring(start, i + 1);
+            }
+        }
+        return trimmed;
+    }
