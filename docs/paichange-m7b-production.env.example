# PaiChange M7b single-instance production acceptance example.
# Copy values into a secret-managed process environment; do not commit real credentials.
PAICHANGE_STORAGE=postgresql
PAICHANGE_POSTGRES_URL=jdbc:postgresql://db.example/paichange?sslmode=verify-full
PAICHANGE_POSTGRES_USER=paichange
PAICHANGE_POSTGRES_PASSWORD=<secret-manager-reference>

PAICHANGE_OBJECT_STORE=s3
PAICHANGE_S3_ENDPOINT=https://s3.example.com
PAICHANGE_S3_BUCKET=paichange-evidence
PAICHANGE_S3_REGION=us-east-1
PAICHANGE_S3_ACCESS_KEY=<secret-manager-reference>
PAICHANGE_S3_SECRET_KEY=<secret-manager-reference>

PAICHANGE_QUEUE_WORKERS=2
PAICHANGE_QUEUE_LEASE_MS=60000
PAICHANGE_QUEUE_POLL_MS=250

PAICHANGE_SCM=gitlab
PAICHANGE_GITLAB_BASE_URL=https://gitlab.example.com
PAICHANGE_GITLAB_PROJECT_ID=group/project
PAICHANGE_GITLAB_TOKEN=<secret-manager-reference>
PAICHANGE_GITLAB_REPOSITORY=/srv/paichange/repository
PAICHANGE_GITLAB_BASE_REF=main
PAICHANGE_GITLAB_REMOTE=origin
PAICHANGE_GITLAB_TIMEOUT_SECONDS=15

# Alternatively select exactly one GitHub repository and remove/ignore the GitLab block above:
# PAICHANGE_SCM=github
# PAICHANGE_GITHUB_API_BASE_URL=https://api.github.com
# PAICHANGE_GITHUB_OWNER=example-owner
# PAICHANGE_GITHUB_REPOSITORY_NAME=example-repository
# PAICHANGE_GITHUB_TOKEN=<secret-manager-reference>
# PAICHANGE_GITHUB_CHECKOUT=/srv/paichange/repository
# PAICHANGE_GITHUB_BASE_REF=main
# PAICHANGE_GITHUB_REMOTE=origin
# PAICHANGE_GITHUB_TIMEOUT_SECONDS=15

PAICHANGE_AUTH=oidc
PAICHANGE_OIDC_ISSUER=https://id.example.com/
PAICHANGE_OIDC_AUDIENCE=paichange-api
PAICHANGE_OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
PAICHANGE_OIDC_ALGORITHMS=RS256
PAICHANGE_OIDC_JWKS_CACHE_SECONDS=300
PAICHANGE_OIDC_HTTP_TIMEOUT_SECONDS=10
PAICHANGE_BOOTSTRAP_ADMIN_SUBJECT=stable-idp-subject

# Deployment objectives. Replace these only with values the target environment can demonstrate.
PAICHANGE_BACKUP_RPO_SECONDS=300
PAICHANGE_RECOVERY_RTO_SECONDS=600
